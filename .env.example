PGHOST=postgres_host
PGDATABASE=db
PGUSER=db_owner
PGPASSWORD=postgres_password
PGPORT=5432

SECRET_KEY=change_this_secret_key
# Must match frontend INTERNAL_AUTH_SECRET.
INTERNAL_AUTH_SECRET=change_this_internal_auth_secret

# Ordered provider fallback. Only providers with configured credentials are loaded.
AI_PROVIDER_ORDER=groq,gemini
# Optional per-task overrides; defaults to AI_PROVIDER_ORDER.
AI_DECOMPOSITION_PROVIDERS=groq,gemini
AI_PLAN_ITERATION_PROVIDERS=groq,gemini

# One initial request plus one retry per provider, bounded by a shared deadline.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=45
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_MIN_SECONDS=0.5
AI_RETRY_MAX_SECONDS=4
AI_MAX_OUTPUT_TOKENS=4096

GEMINI_API_KEY=change_this_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq has an OpenAI-compatible API and a useful free developer tier.
GROQ_API_KEY=change_this_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter can route through free models. Free capacity and models can change.
OPENROUTER_API_KEY=change_this_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Yiyara

# Optional local, unmetered inference. Use host.docker.internal when Django runs in Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
