# Django
SECRET_KEY=your-existing-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=backend,localhost,127.0.0.1

# PostgreSQL
PGHOST=your-database-host
PGDATABASE=your-database-name
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGPORT=5432

# Google authentication
GOOGLE_CLIENT_IDS=your-client-id.apps.googleusercontent.com

# Gemini
GEMINI_API_KEY=your-existing-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# AI routing
AI_PROVIDER_ORDER=gemini
AI_DECOMPOSITION_PROVIDERS=gemini
AI_PLAN_ITERATION_PROVIDERS=gemini

# AI request limits and retries
AI_REQUEST_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=45
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_MIN_SECONDS=0.5
AI_RETRY_MAX_SECONDS=4
AI_MAX_OUTPUT_TOKENS=4096
